    {
      "id": "6af9799ef8f5964429006207",
      "title": "Panthers Pack Trucker Hat",
      "printifyTitle": "Panthers Pack Trucker Hat | Happy Hills Cartoon Game Merch | Run With The Pack Snapback Cap",
      "slug": "panthers-pack-trucker-hat",
      "blocks": [
        {
          "p": "Rep the Pack! This trucker cap carries the Panthers Pack badge from Happy Hills right up front: a bold, comic-style logo for fans of the cartoon and game. Pair it with the matching Panthers Pack tee, or wear it on its own for game nights, road trips, festivals and sunny weekends."
        },
        {
          "p": "The structured mid-profile shape and curved, multi-stitched visor give it a classic trucker look, and the breathable mesh back keeps you cool. One snap and it fits."
        },
        {
          "p": "Product features"
        },
        {
          "h": "",
          "ul": [
            "Adjustable plastic snap closure, one size fits most",
            "Precurved visor with a matching-color underbill",
            "Structured six-panel, mid-profile construction with panel eyelets",
            "Cotton-polyester front and visor with a breathable polyester mesh back",
            "100% cotton sweatband, sewn-in label and visor brand sticker"
          ]
        },
        {
          "p": "Care instructions"
        },
        {
          "h": "",
          "ul": [
            "Spot clean with warm water and a little dish soap; no need to soak the whole cap.",
            "For stubborn spots, use a soft-bristled brush."
          ]
        }
      ],
