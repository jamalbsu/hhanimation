    {
      "id": "6af993462ffca93f7e0d4e72",
      "title": "Panther Mascot Panthers Pack Graphic Sweatshirt",
      "printifyTitle": "Panther Mascot Panthers Pack Graphic Sweatshirt",
      "slug": "panther-mascot-panthers-pack-graphic-sweatshirt",
      "blocks": [
        {
          "p": "A bold sweatshirt for Panther fans who carry their team spirit everywhere. The front graphic features a powerful black panther, warm sunset tones, and the words “Happy Hills” and “Panthers Pack”—a striking design that feels at home on game days, tailgates, campus walks, and cool evenings with your crew. The medium-heavy fleece brings cozy warmth, while the relaxed dropped shoulders and classic fit keep the feel easy and comfortable. Ribbed cuffs and hem add a secure finish, and the clean back lets the front artwork stand out. Wear it when the temperature drops and your Panther pride comes forward."
        },
        {
          "h": "Product features",
          "ul": [
            "80% ring-spun cotton and 20% polyester; fiber content varies by color",
            "Medium-heavy 8.4 oz/yd² (285 g/m²) fleece fabric",
            "Classic fit with relaxed dropped shoulders",
            "Stretch ribbed cuffs and bottom hem with spandex",
            "Seamless tubular construction, tear-away label, and REACH certification"
          ]
        },
        {
          "h": "Care instructions",
          "ul": [
            "Machine wash: cold (max 30C or 90F)",
            "Non-chlorine: bleach as needed",
            "Tumble dry: low heat",
            "Iron, steam or dry: low heat",
            "Do not dryclean"
          ]
        }
      ],
